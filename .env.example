# Local backend configuration. Replace placeholders in your untracked .env file.
DB_URL=jdbc:postgresql://localhost:5432/iot_greenhouse
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-local-database-password

# Required only when AuthBootstrap initializes an empty database.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Keep MQTT disabled until a private, authenticated broker is configured.
MQTT_ENABLED=false
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Use explicit origins in deployed environments; do not use a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEVICE_OFFLINE_TIMEOUT_SECONDS=30

# Optional when frontend and API are served from different origins.
VITE_API_BASE_URL=
