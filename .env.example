# ==============================================================================
# IOT GREENHOUSE — FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Lưu ý: Tạo bản sao thành .env hoặc khai báo trực tiếp vào môi trường máy chủ.
# Tuyệt đối không lưu mật khẩu hoặc thông tin nhạy cảm thật vào kho mã nguồn Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH CƠ SỞ DỮ LIỆU (POSTGRESQL)
# ------------------------------------------------------------------------------
# Địa chỉ máy chủ PostgreSQL
DB_HOST=localhost

# Cổng kết nối PostgreSQL
DB_PORT=5432

# Tên cơ sở dữ liệu
DB_NAME=greenhouse_db

# Chế độ mã hóa SSL khi kết nối PostgreSQL (disable, require, verify-ca, verify-full)
DB_SSL_MODE=disable

# Chuỗi kết nối JDBC trực tiếp (ghi đè kết hợp DB_HOST, DB_PORT, DB_NAME nếu được khai báo)
DB_URL=jdbc:postgresql://localhost:5432/greenhouse_db?sslmode=disable

# Tên người dùng kết nối cơ sở dữ liệu
DB_USERNAME=postgres

# Mật khẩu kết nối cơ sở dữ liệu
DB_PASSWORD=your_db_password_here

# Số lượng kết nối tối đa trong Hikari Connection Pool
DB_POOL_SIZE=10

# Bật/tắt in câu lệnh SQL ra log (true/false)
JPA_SHOW_SQL=false


# ------------------------------------------------------------------------------
# 2. CẤU HÌNH MQTT BROKER (ESP32 & BACKEND GIAO TIẾP)
# ------------------------------------------------------------------------------
# Bật hoặc tắt tích hợp MQTT client trong backend (true/false)
MQTT_ENABLED=true

# Địa chỉ kết nối tới MQTT Broker (Mosquitto/EMQX)
MQTT_BROKER_URL=tcp://localhost:1883

# Tài khoản xác thực MQTT (bỏ trống nếu broker cho phép anonymous)
MQTT_USERNAME=your_mqtt_username

# Mật khẩu xác thực MQTT (bỏ trống nếu broker cho phép anonymous)
MQTT_PASSWORD=your_mqtt_password

# Chế độ clean session của MQTT (false: lưu buffer tin nhắn khi mất mạng; true: fire-and-forget)
MQTT_CLEAN_SESSION=false


# ------------------------------------------------------------------------------
# 3. CẤU HÌNH MÁY CHỦ VÀ PHIÊN LÀM VIỆC (BACKEND SERVER & AUTH)
# ------------------------------------------------------------------------------
# Cổng chạy ứng dụng Spring Boot backend
PORT=8080

# Danh sách origin được phép gọi API (phân tách bởi dấu phẩy, dùng cho CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Thời gian sống của phiên đăng nhập (Bearer Token) tính theo giờ
SESSION_TTL_HOURS=8

# Chu kỳ quét và dọn dẹp phiên đăng nhập hết hạn (milliseconds)
SESSION_CLEANUP_INTERVAL_MS=3600000


# ------------------------------------------------------------------------------
# 4. KHỞI TẠO TÀI KHOẢN QUẢN TRỊ VIÊN MẶC ĐỊNH (BOOTSTRAP ADMIN)
# Áp dụng cho lần khởi động backend đầu tiên khi database chưa có tài khoản admin.
# ------------------------------------------------------------------------------
# Email quản trị viên khởi tạo
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Mật khẩu quản trị viên khởi tạo (yêu cầu tối thiểu 12 ký tự)
BOOTSTRAP_ADMIN_PASSWORD=your_admin_bootstrap_password_min_12_chars


# ------------------------------------------------------------------------------
# 5. CẤU HÌNH LƯU TRỮ VÀ DỌN DẸP DỮ LIỆU CẢM BIẾN (TELEMETRY RETENTION)
# ------------------------------------------------------------------------------
# Số ngày lưu trữ lịch sử dữ liệu cảm biến trước khi tự động xóa (0 để tắt)
TELEMETRY_RETENTION_DAYS=30

# Chu kỳ chạy tác vụ tự động dọn dẹp dữ liệu cảm biến cũ (milliseconds)
TELEMETRY_CLEANUP_INTERVAL_MS=21600000


# ------------------------------------------------------------------------------
# 6. CẤU HÌNH GỬI EMAIL & KHÔI PHỤC MẬT KHẨU (SMTP MAIL SERVICE)
# ------------------------------------------------------------------------------
# Bật tính năng gửi email thông báo / khôi phục mật khẩu (true/false)
EMAIL_ENABLED=false

# Địa chỉ máy chủ SMTP (ví dụ smtp.gmail.com)
MAIL_HOST=smtp.example.com

# Cổng dịch vụ SMTP (587 cho TLS/STARTTLS, 465 cho SSL)
MAIL_PORT=587

# Tài khoản gửi email SMTP
MAIL_USERNAME=your_email@example.com

# Mật khẩu ứng dụng của tài khoản email SMTP (App Password)
MAIL_PASSWORD=your_mail_app_password

# Địa chỉ email người gửi hiển thị
MAIL_FROM=noreply@example.com

# Đường dẫn trang đặt lại mật khẩu trên Web Dashboard
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Giới hạn số yêu cầu đặt lại mật khẩu tối đa từ một địa chỉ IP trong 15 phút
PASSWORD_RESET_REQUEST_LIMIT_PER_IP=10


# ------------------------------------------------------------------------------
# 7. CẤU HÌNH FRONTEND (REACT / VITE)
# ------------------------------------------------------------------------------
# Đường dẫn URL tới Backend REST API
VITE_API_BASE_URL=http://localhost:8080
